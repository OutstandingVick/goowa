# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# --- LLM (agent) ---
# Pick the engine and model. AGENT_ENGINE is a registered engine name:
#   anthropic | ai-sdk:openai | ai-sdk:google | ai-sdk:groq | ai-sdk:mistral
#   ai-sdk:cohere | ai-sdk:openrouter | ai-sdk:ollama | builder
# Unset = auto-detect from whichever provider key is present.
# Org default set in Settings > Model overrides AGENT_ENGINE.
AGENT_ENGINE=anthropic
AGENT_MODEL=claude-sonnet-5-5
# Prefer your own key over the managed Builder gateway when both exist.
AGENT_ENGINE_PREFER_BYO_KEY=true

# Provider keys (set only the one(s) you use)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENROUTER_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Production ---
# DATABASE_URL=postgres://...
